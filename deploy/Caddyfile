# Malt Radar — Caddy: static Flutter web + same-origin /api reverse proxy.
# Caddy obtains + renews Let's Encrypt TLS automatically for the domain.

maltradar.com {
    encode gzip zstd

    root * /srv/web

    # API: same-origin reverse proxy to uvicorn (num: api:8080).
    @api path /api/*
    handle @api {
        reverse_proxy api:8080
        header -Server
        header Cache-Control no-store
    }

    # SEO statik katmanı — /w/, /tr/, /en/, sitemap, llms, robots -> web-seo (spec §2).
    # Flutter SPA'dan ÖNCE servis edilir; robots.txt buradan Sitemap satırlı sürümle kazanır.
    # NOT: adlandırılmış path matcher — handle çoklu desen almaz; handle_path önek SİLER.
    @seo path /w/* /tr/* /en/* /sitemap.xml /llms.txt /robots.txt
    handle @seo {
        root * /srv/web-seo
        file_server
        header Cache-Control "public, max-age=3600"
    }

    # Static Flutter web (CanvasKit). SPA fallback to index.html.
    # Cache stratejisi (2026-08-11 — deploy güvenilirlik fix'i):
    # - index.html + Flutter JS çekirdeği NO-CACHE: SW-unregister script'i ve
    #   asset manifest'i bu dosyalarda. Bayat index.html = bayat build sonsuza dek
    #   (SW, network'e çıkmadan eski index.html'i serve eder; caddy log'unda hiç
    #   istek görünmez). no-cache = her navigasyonda revalidate, bayat servis yok.
    # - Hash'li statikler (assets/, canvaskit/) 1 yıl cache'lenebilir — içerikleri
    #   build sürümüne bağlı, isimleri değişiyor.
    # NOT: header'lar AYRI terminal handle'larda — aynı blokta iki header yazmak
    # işe yaramaz (Caddy route sort'u match'siz generic route'u sona koyar, o da
    # no-cache'i ezer). handle'lar sırayla denenir, ilk eşleşen terminaldir.
    @nocache path / /index.html /main.dart.js /flutter_service_worker.js /flutter_bootstrap.js /drift_worker.js
    handle @nocache {
        file_server
        try_files {path} /index.html
        header Cache-Control "no-cache"
    }
    handle {
        file_server
        try_files {path} /index.html
        header Cache-Control "public, max-age=31536000"
    }

    # Crawlers: catalog is served only via the API layer.
    header /robots.txt Content-Type "text/plain; charset=utf-8"
}
