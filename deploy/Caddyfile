# Malt Radar — Caddy: static Flutter web + same-origin /api reverse proxy.
# Caddy obtains + renews Let's Encrypt TLS automatically for the domain.

maltradar.com {
    encode gzip zstd

    root * /srv/web

    # API: same-origin reverse proxy to uvicorn (num: api:8080).
    @api path /api/*
    handle @api {
        reverse_proxy api:8080
        header -Server
        header Cache-Control no-store
    }

    # SEO statik katmanı — /w/, /tr/, /en/, sitemap, llms, robots -> web-seo (spec §2).
    # Flutter SPA'dan ÖNCE servis edilir; robots.txt buradan Sitemap satırlı sürümle kazanır.
    # NOT: adlandırılmış path matcher — handle çoklu desen almaz; handle_path önek SİLER.
    @seo path /w/* /tr/* /en/* /sitemap.xml /llms.txt /robots.txt
    handle @seo {
        root * /srv/web-seo
        file_server
        header Cache-Control "public, max-age=3600"
    }

    # Static Flutter web (CanvasKit). SPA fallback to index.html.
    # Kısa TTL: Cloudflare origin'de Cache-Control yokken 4s default TTL uyguluyor
    # -> her deploy'da bayat build servis ediliyordu. 300s ile yeni build hızla yayılır.
    handle {
        file_server
        try_files {path} /index.html
        header Cache-Control "public, max-age=300"
    }

    # Crawlers: catalog is served only via the API layer.
    header /robots.txt Content-Type "text/plain; charset=utf-8"
}
