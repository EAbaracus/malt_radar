# Copy to deploy/.env and fill real values. Never commit .env.

# Strong random API key (the /api/db shared key).
#   openssl rand -hex 32
MALT_RADAR_API_KEY=REPLACE_WITH_STRONG_RANDOM

# Enable the read-only catalog API (/api/db).
# NOTE (anti-scrape prerequisite): see deploy/README — resolve client auth on
# /api/db (per-user bearer) BEFORE switching this on for a public webapp. Do NOT
# embed this shared key in the Flutter web bundle.
# Catalog = /api/db + /api/whiskies/search (now CSV-only single source).
# MUST stay false until per-user bearer auth gates /api/db (anti-scrape
# precondition): with true and only shared MALT_RADAR_API_KEY, a public
# webapp would depend on a key that must never ship to a browser. See
# docs/deployment-live-status.md.
DB_API_ENABLED=false

# CORS: the webapp origin (same-origin via Caddy needs no CORS, but native/
# desktop apps call the API cross-origin and must be listed).
MALT_RADAR_ALLOWED_ORIGINS=https://maltradar.com

# Catalog anti-scrape bounds (server-side caps).
CATALOG_MAX_PAGE=50
CATALOG_MAX_OFFSET=10000

# Prices are never exposed (Product Rule). Keep false.
SHOW_PRICE_DATA=false
