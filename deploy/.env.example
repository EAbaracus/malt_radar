# Copy to deploy/.env and fill real values. Never commit .env.

# Strong random API key (the /api/db shared key).
#   openssl rand -hex 32
MALT_RADAR_API_KEY=REPLACE_WITH_STRONG_RANDOM

# Enable the read-only catalog API (/api/db).
# SAFE NOW: /api/db depends on per-user bearer auth (get_current_user), NOT a
# shared key (commit 68bb9b4). A public webapp authenticates with the account
# token; the shared MALT_RADAR_API_KEY never ships to a browser. Anti-scrape
# precondition is met -> it is now safe to set true for the public webapp.
DB_API_ENABLED=false

# CORS: the webapp origin (same-origin via Caddy needs no CORS, but native/
# desktop apps call the API cross-origin and must be listed).
MALT_RADAR_ALLOWED_ORIGINS=https://maltradar.com

# Catalog anti-scrape bounds (server-side caps).
CATALOG_MAX_PAGE=50
CATALOG_MAX_OFFSET=10000

# Prices are never exposed (Product Rule). Keep false.
SHOW_PRICE_DATA=false
