{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://malt-radar.local/mr-kep/schemas/manifest.schema.json",
  "title": "MR-KEP Pipeline Manifest",
  "description": "Declares one pipeline run: sources, stages invoked, inputs/outputs, deterministic seed, and gate status. Consumed by AOUS to orchestrate and audit a run.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "pipeline_name", "created_at", "deterministic", "sources", "stages", "gate"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "manifest_id": { "type": "string", "pattern": "^MRKEP-[0-9]{8}-[0-9]{6}$" },
    "pipeline_name": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "deterministic": {
      "type": "boolean",
      "description": "MUST be true. MR-KEP runs are reproducible; any randomness is a violation."
    },
    "seed": {
      "type": "integer",
      "description": "Fixed seed for any deterministic ordering (e.g. tie-break sort)."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_key", "profile_ref", "scope"],
        "properties": {
          "source_key": { "type": "string" },
          "profile_ref": { "type": "string", "description": "Path to the source_profile.yaml" },
          "scope": {
            "type": "object",
            "description": "Qualification scope (which whiskies/date-range/pages).",
            "additionalProperties": true
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "agent", "status"],
        "properties": {
          "stage": { "enum": ["qualification", "extraction", "validation", "merge", "certification", "audit"] },
          "agent": { "type": "string" },
          "status": { "enum": ["pending", "running", "passed", "failed", "skipped"] },
          "input_ref": { "type": "string" },
          "output_ref": { "type": "string" },
          "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evaluated_at"],
      "properties": {
        "status": { "enum": ["GO", "PARTIAL_GO", "NO_GO", "AWAITING_APPROVAL"] },
        "evaluated_at": { "type": "string", "format": "date-time" },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
