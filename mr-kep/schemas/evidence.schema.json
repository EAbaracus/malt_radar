{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://malt-radar.local/mr-kep/schemas/evidence.schema.json",
  "title": "MR-KEP Evidence Record",
  "description": "Provenance + confidence for a single certified fact. Every certified knowledge item embeds an evidence record. Evidence-first rule: no fact without an evidence record.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fact_id", "field", "value", "confidence", "authority_tier", "sources"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "fact_id": { "type": "string", "description": "Stable, deterministic ID (hash of field+whisky+value)." },
    "field": { "type": "string" },
    "value": { "type": ["string", "number", "null"] },
    "normalization": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "authority_tier": { "enum": ["T1_authoritative", "T2_expert", "T3_community"] },
    "decided_by_policy": { "type": "string", "description": "merge_policies.yaml key used to resolve." },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_key", "source_url", "quote", "evidence_type"],
        "properties": {
          "source_key": { "type": "string" },
          "source_url": { "type": "string", "format": "uri" },
          "quote": { "type": "string" },
          "evidence_type": { "enum": ["primary_source_quote", "bottle_print", "expert_quote", "aggregated_link", "inferred"] },
          "won": { "type": "boolean", "description": "true if this source's value was selected as the winning value." }
        }
      }
    },
    "conflict": {
      "type": "object",
      "description": "Present only when multiple sources disagreed.",
      "additionalProperties": false,
      "required": ["resolved", "reason"],
      "properties": {
        "resolved": { "type": "boolean" },
        "reason": { "type": "string" },
        "losers_kept": { "type": "boolean" }
      }
    }
  }
}
