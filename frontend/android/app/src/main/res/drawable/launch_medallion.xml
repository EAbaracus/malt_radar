<?xml version="1.0" encoding="utf-8"?>
<!-- Marka medallion'u (etiketsiz 7-gen) — native splash için statik vektör.
     Geometri frontend MedallionPainter outer7 ile birebir; purple copper web,
     brass rim+needle. Renkler app_theme_colors.dart token'larından. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- Dış mühür halkası (brass, rheostat) -->
    <path
        android:pathData="M 100,5 A 95,95 0 1 1 99.99,5 Z"
        android:strokeColor="#C9A227"
        android:strokeWidth="1.6"
        android:fillColor="#00000000" />

    <!-- İç mühür halkası (brass, soluk) -->
    <path
        android:pathData="M 100,12 A 88,88 0 1 1 99.99,12 Z"
        android:strokeColor="#C9A227"
        android:strokeWidth="0.6"
        android:fillColor="#00000000" />

    <!-- 7-gen dış köşe (copper) — outer7 noktaları -->
    <path
        android:pathData="M 100,30 L 154.73,56.35 L 168.26,115.57 L 130.37,163.07 L 69.63,163.07 L 31.74,115.57 L 45.27,56.35 Z"
        android:strokeColor="#A6672C"
        android:strokeWidth="1.3"
        android:fillColor="#00000000" />

    <!-- İbre tipi (brass) -->
    <path
        android:pathData="M 100,34 L 100,100"
        android:strokeColor="#C9A227"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Merkez pivot (brass) -->
    <path
        android:pathData="M 100,96.6 A 3.4,3.4 0 1 1 99.99,96.6 Z"
        android:strokeColor="#C9A227"
        android:strokeWidth="0.01"
        android:fillColor="#C9A227" />
</vector>
